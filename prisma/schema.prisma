// Prisma schema generated for Milestone 003 – Conversations
// This schema mirrors the domain model defined in specs/M003-Conversations.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum ConversationStatus {
  NEW
  ACTIVE
  WAITING_CUSTOMER
  WAITING_AGENT
  RESOLVED
  ARCHIVED
  SPAM
}

enum MessageDirection {
  IN
  OUT
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  STICKER
  SYSTEM
  LOCATION
  CONTACT
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum ConversationEventType {
  CONVERSATION_CREATED
  MESSAGE_ADDED
  MESSAGE_STATUS_UPDATED
  CONVERSATION_STATUS_CHANGED
  CONVERSATION_CLOSED
  TAG_ADDED
  TAG_REMOVED
  INTERNAL_NOTE_ADDED
  ASSIGNMENT_CHANGED
  ATTACHMENT_ADDED
}

// ---------- Models ----------
model Contact {
  id          String   @id @default(uuid())
  tenantId    String
  phoneNumber String
  name        String?
  email       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  conversations Conversation[]

  @@unique([tenantId, phoneNumber])
}

model Conversation {
  id           String   @id @default(uuid())
  tenantId     String
  contactId    String
  status       ConversationStatus @default(NEW)
  assignedTo   String?
  leadId       String?
  openedAt     DateTime?
  closedAt     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  contact      Contact @relation(fields: [contactId], references: [id])
  messages     Message[]
  tags         ConversationTag[]
  events       ConversationEvent[]
  internalNotes InternalNote[]
}

model Message {
  id                 String   @id @default(uuid())
  conversationId     String
  direction          MessageDirection
  type               MessageType
  content            String
  providerMessageId String?
  sentAt             DateTime?
  receivedAt         DateTime @default(now())
  status             MessageStatus @default(SENT)
  metadata           Json?
  createdAt          DateTime @default(now())

  // Relations
  conversation       Conversation @relation(fields: [conversationId], references: [id])
  attachments        Attachment[]
}

model Attachment {
  id        String   @id @default(uuid())
  messageId String
  type      MessageType
  url       String
  mimeType  String
  sizeBytes Int
  metadata  Json?
  createdAt DateTime @default(now())

  // Relations
  message   Message @relation(fields: [messageId], references: [id])
}

model Tag {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  conversationTags ConversationTag[]

  @@unique([tenantId, name])
}

model ConversationTag {
  id             String   @id @default(uuid())
  conversationId String
  tagId          String
  createdAt      DateTime @default(now())

  // Relations
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  tag           Tag          @relation(fields: [tagId], references: [id])
}

model InternalNote {
  id             String   @id @default(uuid())
  conversationId String
  authorId       String
  content        String
  createdAt      DateTime @default(now())

  // Relations
  conversation   Conversation @relation(fields: [conversationId], references: [id])
}

model ConversationEvent {
  id             String   @id @default(uuid())
  conversationId String
  type           ConversationEventType
  payload        Json
  createdAt      DateTime @default(now())

  // Relations
  conversation   Conversation @relation(fields: [conversationId], references: [id])
}

// ============================================================
// Milestone 1 – WhatsApp Connectivity
// Adicionado em 2026-07-06. Não altera, não depende e não
// referencia nenhum model/enum acima (domínio legado
// "Conversations", Milestone 003 — migração adiada, ver
// DECISIONS.md ADR #11 e PROJECT_STATUS.md §2.1).
// ============================================================

// ---------- Enums (WhatsApp Connectivity) ----------

/// Espelha exatamente os 3 estados usados hoje em
/// apps/api/src/services/whatsapp/domain/entities/WhatsAppSession.ts
/// (`status: 'connected' | 'disconnected' | 'connecting'`).
/// Propositalmente NÃO foram adicionados estados extras (ex.: "QR_PENDING",
/// "ERROR") que ainda não existem na entidade de Domain — evita repetir o
/// defeito já encontrado no schema legado (`ConversationStatus.CLOSED`
/// referenciado em código/testes mas inexistente no enum real).
enum WhatsAppSessionStatus {
  CONNECTING
  CONNECTED
  DISCONNECTED

  @@map("whatsapp_session_status")
}

/// Espelha `WhatsAppDisconnectReason`
/// (apps/api/src/services/whatsapp/domain/entities/WhatsAppDisconnectReason.ts),
/// Production Hardening Bloco 8a — motivo da ÚLTIMA desconexão, campo
/// SEPARADO de `WhatsAppSessionStatus` (ver docstring do tipo de Domain para
/// a justificativa de não misturar estado com motivo). `NULL` enquanto nunca
/// houve queda, ou depois que a sessão volta a se conectar (limpo pela
/// Application/Infrastructure, não pelo banco).
enum WhatsAppDisconnectReason {
  LOGGED_OUT
  RESTART_REQUIRED
  CONNECTION_LOST
  TIMED_OUT
  UNKNOWN

  @@map("whatsapp_disconnect_reason")
}

/// Corrige o achado F6 do Architecture Gate Review (2026-07-06): `provider`
/// era `String` livre, permitindo divergências como `'Baileys'` vs
/// `'baileys'` — a mesma classe de bug já encontrada no schema legado
/// (`ConversationStatus.CLOSED` inexistente, mas referenciado em código).
/// Hoje só existe `BAILEYS`, o único provider decidido (ver DECISIONS.md,
/// item 10). Novos valores são adicionados apenas quando uma segunda
/// implementação real de `WhatsAppProvider` existir — não antecipamos
/// `EVOLUTION_API`/`CLOUD_API`/etc. especulativamente (YAGNI; ver também a
/// decisão registrada para o achado F9, que evita generalizar o port antes
/// de uma segunda necessidade real).
enum WhatsAppProviderType {
  BAILEYS

  @@map("whatsapp_provider_type")
}

// ---------- Enums (Conversas — Milestone 3, Bloco 2) ----------

/// Controla se a IA responde automaticamente a novas mensagens de uma
/// `WhatsAppConversation` (`BOT`) ou se um humano assumiu o atendimento
/// (`HUMAN`) — ver `shouldAutoRespond()` (Domain, `services/conversations`).
/// Enum, não `Boolean`: mesmo racional do achado F6/ADR #15 (já aplicado a
/// `WhatsAppSessionStatus`/`WhatsAppProviderType`) — um valor auto-explicativo
/// no banco em vez de um `assignedToHuman: true` que exige ler código para
/// entender o sentido.
enum WhatsAppConversationStatus {
  BOT
  HUMAN

  @@map("whatsapp_conversation_status")
}

/// Estágio de funil de vendas de uma `WhatsAppConversation` — Milestone 6,
/// Bloco M6H-5 (2026-07-30). Funil clássico de 5 estágios (2 terminais),
/// fixo em código (não customizável por tenant nesta rodada — decisão do
/// fundador, mesma disciplina de YAGNI já usada para `WhatsAppProviderType`/
/// RBAC fixo: generalizar sem um segundo caso de uso real seria abstração
/// especulativa). Deliberadamente SEM estágio "qualificação" separado
/// (opção descartada pelo fundador) — `CONTACTED` já cobre esse papel.
enum ConversationStage {
  NEW
  CONTACTED
  NEGOTIATING
  CLOSED_WON
  CLOSED_LOST

  @@map("conversation_stage")
}

/// Quem gravou o `ConversationStage` atual pela ÚLTIMA vez — mesmo racional
/// de `WhatsAppConversationStatus`, um enum em vez de um booleano
/// (`stageSetByHuman: true`) para ficar auto-explicativo no banco. Controla
/// a policy "a IA nunca sobrescreve uma correção manual": a IA só pode
/// gravar um novo estágio quando o valor atual deste campo for `AI` (ver
/// `services/conversations/domain/policies/shouldAiUpdateStage.ts`).
enum ConversationStageSetBy {
  AI
  HUMAN

  @@map("conversation_stage_set_by")
}

/// Sentido de uma `WhatsAppMessage` dentro de uma conversa. Nome
/// deliberadamente prefixado `WhatsAppMessage`, não `MessageDirection`: o
/// schema já tem um enum `MessageDirection` no domínio legado "Milestone
/// 003" (congelado, ADR #11) — ver nota de colisão de nomenclatura no model
/// `WhatsAppMessage` abaixo.
enum WhatsAppMessageDirection {
  INBOUND
  OUTBOUND

  @@map("whatsapp_message_direction")
}

/// Tipo de conteúdo de uma `WhatsAppMessage` — Fase 1, Bloco F1.1 (suporte a
/// mídia, ver DECISIONS.md ADR #90). Espelha exatamente as categorias que o
/// protocolo WhatsApp/Baileys distingue (`imageMessage`/`audioMessage`/
/// `videoMessage`/`documentMessage`/`stickerMessage`) — nenhuma categoria
/// nova inventada além do que o protocolo já separa. `TEXT` é o default e o
/// único valor que existia implicitamente antes desta migration.
enum WhatsAppMessageContentType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  STICKER

  @@map("whatsapp_message_content_type")
}

// ---------- Models (WhatsApp Connectivity) ----------

/// Preparação multi-tenant (CLAUDE.md, regra permanente 6: "pensar no
/// crescimento: design para multi-tenant desde o início"). Este model existe
/// para que a FK de WhatsAppSession tenha integridade referencial real, em
/// vez de um tenantId solto sem @relation (o mesmo defeito encontrado no
/// schema legado, onde tenantId é String sem FK em 3 tabelas). A entidade de
/// Domain WhatsAppSession (TS) também já expõe `tenantId` (adicionado na
/// revisão arquitetural pós-Item 2 — ver PROJECT_STATUS.md).
model Tenant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Hash da API key emitida para este tenant (Production Hardening, Bloco
  /// 1) — nunca a chave em texto plano. `null` até uma chave ser emitida
  /// (provisionamento continua manual nesta milestone; ver
  /// TenantRepository.ts). `@unique` permite localizar o tenant pelo hash em
  /// O(1) e garante que duas chaves nunca colidam no mesmo hash.
  apiKeyHash String? @unique @map("api_key_hash")

  whatsAppSessions      WhatsAppSession[]
  tenantCredentials     TenantCredential[]
  whatsAppSessionEvents WhatsAppSessionEvent[]
  whatsAppConversations WhatsAppConversation[]
  aiInteractions        AiInteraction[]
  // Milestone 5, Bloco M5A — usuarios e trilha de auditoria do tenant.
  users                 User[]
  auditLogs             AuditLog[]
  // Base de Conhecimento (Nivel 1) — um perfil de negocio POR SESSAO desde a
  // Milestone 6, Bloco M6H-3 (2026-07-25) — antes era um unico perfil por
  // tenant (campo escalar `?`); agora e uma lista, pois cada WhatsApp do
  // tenant pode ter seu proprio "cerebro" (ver AiBusinessProfile).
  aiBusinessProfiles    AiBusinessProfile[]
  // Fase 1, Bloco F1.9 — respostas rapidas por sessao.
  quickReplies          QuickReply[]
  // Redesign 2026-08-05 (R4) — catálogo de tags livres por sessão.
  tags                  WhatsAppTag[]
  // Fase L, Bloco L1 (2026-08-15) — identidade durável de contato, por TENANT
  // (não por sessão): a mesma pessoa falando com dois WhatsApps da empresa é
  // uma pessoa só. Ver `WhatsAppContact`.
  contacts              WhatsAppContact[]
  // Fase L, Bloco L2 (2026-08-15) — log de consentimento (opt-in/opt-out).
  contactConsentEvents  ContactConsentEvent[]
  // Fase L, Bloco L3 (2026-08-17) — campanhas de disparo em lote (só criação
  // e cálculo de destinatários nesta rodada, sem envio).
  campaigns             Campaign[]
  campaignRecipients    CampaignRecipient[]

  @@map("tenants")
}

/// Identidade durável de uma pessoa, por tenant — Fase L, Bloco L1
/// (2026-08-15). O Francis nunca teve conceito de PESSOA: até aqui a
/// identidade de um contato era o `contactJid` dentro de
/// `WhatsAppConversation`, chaveado por `(tenantId, sessionName, contactJid)`.
/// Isso significa que a mesma pessoa falando com duas sessões da empresa eram
/// duas entidades sem nenhuma ligação, e que não havia onde guardar nome
/// próprio, origem ou consentimento. O incidente de LID já cobrou esse preço
/// uma vez: um contato conhecido virou duas conversas e a correção exigiu
/// mesclar linhas manualmente no Postgres.
///
/// POR TENANT, não por sessão — diferente de `AiBusinessProfile`/`QuickReply`/
/// `WhatsAppTag`, que são configuração de cada número atendido. Uma pessoa não
/// muda de identidade porque escreveu para outro número da mesma empresa; é
/// justamente cruzar as sessões que dá valor ("este lead da campanha já era
/// cliente no outro WhatsApp").
///
/// `phoneE164` é a IDENTIDADE, não o endereço de envio. Guarda a forma
/// canônica calculada por `normalizePhoneToE164` (Domain), que unifica o 9º
/// dígito dos celulares brasileiros — decisão do fundador, para que o mesmo
/// aparelho digitado numa planilha caia no contato que já existe. Para ENVIAR,
/// use sempre o `contactJid` da conversa: ele pode estar na forma de 12
/// dígitos, e mandar para a forma canônica entregaria a outro número.
///
/// Conversas em `@lid` (endereço de privacidade do WhatsApp — 13 de 51 na base
/// real) NÃO têm contato: não existe telefone a extrair de um LID. Ficam com
/// `contactId` nulo até a pessoa escrever de um endereço com número real.
model WhatsAppContact {
  id        String        @id @default(uuid())
  tenantId  String        @map("tenant_id")
  phoneE164 String        @map("phone_e164")
  /// Nome próprio do lead, definido por quem opera (importação ou edição) —
  /// deliberadamente SEPARADO de `WhatsAppConversation.contactName`, que é o
  /// `pushName` escolhido pelo próprio contato no WhatsApp dele e muda sem
  /// aviso. `null` para contatos criados automaticamente a partir de uma
  /// conversa: nesse momento não há nome que o operador tenha escolhido.
  name      String?
  /// COMO o contato entrou no sistema. Enum, não string livre — mesmo racional
  /// do achado F6/ADR #15. Não confundir com a origem COMERCIAL do lead
  /// ("feira", "site", "indicação"), que é texto livre e entra junto com a
  /// importação de planilha, onde de fato existe alguém para informá-la.
  source    ContactSource @default(WHATSAPP)
  /// Fase L, Bloco L2 (2026-08-15) — quando este contato pediu para NÃO
  /// receber mais campanhas, ou `null` se nunca pediu (ou se já foi revertido
  /// por um opt-in manual). Preenchido automaticamente quando a pessoa
  /// responde uma palavra-chave de saída (ver `optOutKeywords.ts`), ou
  /// manualmente por quem administra a base.
  ///
  /// Efeito é DELIBERADAMENTE restrito a campanhas — decisão de produto
  /// registrada em `FASE_L_MOTOR_DE_LEADS.md` §8: opt-out desliga só o envio
  /// em lote (ainda inexistente nesta rodada), NUNCA o atendimento normal. A
  /// pessoa continua conversando com a IA/operador normalmente; só não entra
  /// mais em nenhuma campanha futura.
  optOutAt  DateTime?     @map("opt_out_at")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations WhatsAppConversation[]

  /// A garantia de deduplicação, no nível do banco: um telefone canônico
  /// existe no máximo uma vez por tenant. É isto que faz a importação de uma
  /// planilha com repetidos ser idempotente sem nenhuma lógica extra.
  @@unique([tenantId, phoneE164])
  @@index([tenantId])
  /// Suporta a futura supressão de opt-out na materialização de campanha
  /// (`WHERE opt_out_at IS NULL`) — índice parcial seria ainda mais preciso,
  /// mas o Prisma não expressa índice parcial nativamente; este já evita
  /// varredura completa da tabela.
  @@index([tenantId, optOutAt])
  @@map("whatsapp_contacts")
}

/// Tipo de evento de consentimento — Fase L, Bloco L2. Enum, não string
/// livre, mesmo racional do achado F6/ADR #15.
enum ConsentEventType {
  OPT_IN
  OPT_OUT

  @@map("consent_event_type")
}

/// Log de consentimento, append-only — Fase L, Bloco L2. Uma linha por
/// mudança de status (opt-out automático por palavra-chave, opt-out manual,
/// ou reversão/opt-in manual). É o registro que se apresenta se a ANPD
/// perguntar "quando e por que esta pessoa parou de receber campanhas".
///
/// SEM FK para `WhatsAppContact` — mesmo padrão e mesma justificativa de
/// `AuditLog`/`WhatsAppSessionEvent`: a prova de consentimento precisa
/// SOBREVIVER à exclusão do contato que descreve. `contactId` fica gravado
/// para sempre, mesmo que o contato seja apagado.
model ContactConsentEvent {
  id          String           @id @default(uuid())
  tenantId    String           @map("tenant_id")
  contactId   String           @map("contact_id")
  type        ConsentEventType
  /// Texto curto do motivo — "palavra-chave: parar", "manual", "importação".
  /// Livre de propósito (não enum): motivos novos não devem exigir migration.
  reason      String?
  /// Quem executou a ação, quando foi manual (um operador clicando no botão).
  /// `null` no opt-out automático por palavra-chave — não há ator humano.
  actorUserId String?          @map("actor_user_id")
  occurredAt  DateTime         @default(now()) @map("occurred_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, contactId, occurredAt])
  @@map("contact_consent_events")
}

/// Como um `WhatsAppContact` entrou no sistema — Fase L, Bloco L1.
enum ContactSource {
  /// Criado automaticamente quando a pessoa mandou mensagem.
  WHATSAPP
  /// Veio de uma planilha importada (Bloco L1b, ainda não implementado).
  IMPORT
  /// Cadastrado à mão pelo operador.
  MANUAL

  @@map("contact_source")
}

/// Estado de uma campanha — Fase L, Bloco L3. `SCHEDULED`/`RUNNING`/`PAUSED`/
/// `COMPLETED`/`CANCELLED` existem no enum desde já, mesmo sem UI para eles
/// nesta rodada (nenhum motor de envio existe ainda — ver `Campaign`), para
/// não exigir migration nova quando o L4/L5 (fila + disjuntor) forem
/// implementados. L3 só produz campanhas em `DRAFT`.
enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED

  @@map("campaign_status")
}

/// Uma campanha de disparo em lote — Fase L, Bloco L3.
///
/// **Este bloco só CRIA e CALCULA quem receberia — NÃO envia nenhuma
/// mensagem.** O envio de fato (fila `campaign-send`, ritmo/`intervalSeconds`,
/// disjuntor de segurança) é trabalho do L4/L5, ainda não implementado; os
/// campos de ritmo abaixo já existem no schema por decisão de projeto
/// (`FASE_L_MOTOR_DE_LEADS.md` §10.3): mais barato declará-los agora do que
/// fazer uma segunda migration quando o motor de envio nascer.
///
/// Por sessão (não tenant-wide, diferente de `WhatsAppContact`) — uma
/// campanha dispara por um número de WhatsApp específico.
model Campaign {
  id              String         @id @default(uuid())
  tenantId        String         @map("tenant_id")
  sessionName     String         @map("session_name")
  name            String
  /// Reorganização Contatos/Campanhas (2026-08-17): texto livre opcional,
  /// só para o operador se orientar na lista — nunca lido por nenhuma regra.
  description     String?        @db.Text
  messageTemplate String         @db.Text @map("message_template")
  status          CampaignStatus @default(DRAFT)
  scheduledFor    DateTime?      @map("scheduled_for")
  intervalSeconds Int            @default(75) @map("interval_seconds")
  dailyLimit      Int            @default(30) @map("daily_limit")
  sendWindowStart String?        @map("send_window_start")
  sendWindowEnd   String?        @map("send_window_end")
  pausedReason    String?        @map("paused_reason")
  createdByUserId String?        @map("created_by_user_id")
  /// Fase L, Bloco L8 (2026-08-20) — mídia OPCIONAL anexada ao disparo (imagem/
  /// vídeo/documento). `mediaContent` guarda o BINÁRIO em `bytea` — decisão
  /// deliberada de manter tudo em Postgres, sem storage de arquivo/volume novo
  /// (mesma filosofia "tudo em Postgres" já usada no projeto; o teto de
  /// tamanho — `MAX_CAMPAIGN_MEDIA_UPLOAD_BYTES`, `CampaignService` — mantém
  /// isso barato mesmo para uma campanha rodando por dias). As quatro colunas
  /// nascem juntas ou vazias juntas — nunca uma sem a outra (garantido pela
  /// aplicação, não por CHECK: `attachMedia`/`removeMedia` sempre gravam/
  /// limpam as quatro de uma vez). NUNCA incluído no `select` default das
  /// leituras normais (`findById`/`listByTenant`) — só o binário entraria
  /// inteiro em toda resposta JSON de lista/detalhe; ver `CAMPAIGN_SELECT` em
  /// `PrismaCampaignRepository`.
  mediaContent     Bytes?                      @map("media_content")
  mediaMimeType    String?                     @map("media_mime_type")
  mediaFileName    String?                     @map("media_file_name")
  mediaContentType WhatsAppMessageContentType? @map("media_content_type")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipients CampaignRecipient[]

  @@index([tenantId, sessionName, status])
  @@map("campaigns")
}

/// Status de um destinatário DENTRO de uma campanha — Fase L, Bloco L3.
/// `SENT`/`FAILED`/`REPLIED` só passam a existir de fato a partir do L4/L5
/// (envio real); nesta rodada, a materialização só produz `PENDING` (elegível)
/// ou `SKIPPED` (suprimido, com `skipReason`).
enum CampaignRecipientStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
  REPLIED

  @@map("campaign_recipient_status")
}

/// Um destinatário calculado de uma campanha — onde mora o "63 de 100, eis os
/// motivos" (Fase L, Bloco L3). Uma linha por `(campaignId, contactId)`,
/// criada na MATERIALIZAÇÃO (`CampaignService.createCampaign`), nunca editada
/// à mão.
///
/// `skipReason` é texto livre (não enum) DE PROPÓSITO — mesmo racional de
/// `ContactConsentEvent.reason`: motivos novos de supressão não devem exigir
/// migration. Os três usados por este bloco: `"opt_out"`,
/// `"active_human_conversation"`, `"recently_contacted"`.
///
/// SEM relação Prisma para `WhatsAppContact`/`WhatsAppConversation` — mesmo
/// padrão de baixo acoplamento entre bounded contexts já usado em
/// `AuditLog`/`ContactConsentEvent` (o id fica gravado, sem FK).
///
/// Reorganização Contatos/Campanhas (2026-08-17): `contactId` deixou de ser
/// obrigatório. Um destinatário vindo de planilha/lista colada que NÃO
/// corresponde a nenhum `WhatsAppContact` já existente nasce só com
/// `phoneE164`/`name` (um "retrato" no momento da criação — nunca força a
/// criação de um Contato no CRM). Quando o telefone já é um contato
/// conhecido, `contactId` é preenchido (mesmo comportamento de antes) e
/// `phoneE164`/`name` ficam vazios — a aplicação (`CampaignService`) garante
/// que toda linha tem UM dos dois, nunca nenhum (reforçado pelo `CHECK` no
/// banco, ver migration).
model CampaignRecipient {
  id             String                  @id @default(uuid())
  tenantId       String                  @map("tenant_id")
  campaignId     String                  @map("campaign_id")
  contactId      String?                 @map("contact_id")
  /// Só preenchido quando `contactId` é nulo — o número "bruto" (já
  /// normalizado, `normalizePhoneToE164`) de quem não tem Contato salvo.
  phoneE164      String?                 @map("phone_e164")
  /// Nome opcional trazido pela planilha/lista manual (coluna "nome" do CSV,
  /// ou digitado junto do número) — só existe junto de `phoneE164`.
  name           String?
  status         CampaignRecipientStatus @default(PENDING)
  skipReason     String?                 @map("skip_reason")
  errorMessage   String?                 @db.Text @map("error_message")
  sentAt         DateTime?               @map("sent_at")
  repliedAt      DateTime?               @map("replied_at")
  conversationId String?                 @map("conversation_id")
  /// Fase L, Bloco L4 (2026-08-17) — quando o ENVIO foi de fato tentado
  /// (sucesso OU falha), independente de `sentAt` (que só existe no
  /// sucesso). Sustenta o disjuntor de segurança: "as últimas N tentativas,
  /// em ordem cronológica, tiveram taxa de falha alta?" — sem este campo não
  /// haveria como ordenar uma tentativa FALHA no tempo (só `createdAt`, que é
  /// quando o destinatário foi MATERIALIZADO, não quando foi tentado).
  attemptedAt    DateTime?               @map("attempted_at")
  createdAt      DateTime                @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  /// Idempotência, camada 1: materializar a mesma campanha duas vezes nunca
  /// duplica um destinatário (`createMany({ skipDuplicates: true })`). Postgres
  /// trata múltiplos `NULL` como distintos nesta constraint — inofensivo,
  /// porque linhas sem `contactId` já chegam deduplicadas por `phoneE164`
  /// (ver `@@unique` abaixo) antes de `createRecipients` ser chamado.
  @@unique([campaignId, contactId])
  /// Mesma idempotência para o caminho sem Contato (planilha/manual):
  /// mesmo `phoneE164` na mesma campanha nunca duplica.
  @@unique([campaignId, phoneE164])
  @@index([tenantId, campaignId, status])
  /// Suporta a regra de supressão "contatado por OUTRA campanha há menos de
  /// 7 dias" — busca por `(tenantId, contactId, status, sentAt)` sem varrer a
  /// tabela inteira.
  @@index([tenantId, contactId, status, sentAt])
  /// Fase L, Bloco L4 — suporta o disjuntor de segurança ("últimas N
  /// tentativas desta campanha, em ordem") e o teto diário ("quantos SENT
  /// hoje nesta campanha").
  @@index([tenantId, campaignId, attemptedAt])
  @@map("campaign_recipients")
}

/// Espelha apps/api/src/services/whatsapp/domain/entities/WhatsAppSession.ts
/// (incluindo `tenantId`, adicionado na revisão arquitetural pós-Item 2, e
/// `provider` tipado como enum desde o achado F6 do Architecture Gate
/// Review). Credenciais Baileys/authState não fazem parte deste model — não
/// por estarem indefinidas (essa lacuna foi resolvida, ver `TenantCredential`
/// abaixo e ADR #21), mas por decisão arquitetural deliberada: o ciclo de
/// vida de um segredo é desacoplado do registro operacional de sessão, então
/// vivem em tabelas diferentes.
model WhatsAppSession {
  id          String                @id @default(uuid())
  tenantId    String                @map("tenant_id")
  sessionName String                @map("session_name")
  provider    WhatsAppProviderType  @default(BAILEYS)
  status      WhatsAppSessionStatus @default(DISCONNECTED)
  /// Motivo da última desconexão (Production Hardening, Bloco 8a) — ver
  /// enum `WhatsAppDisconnectReason` acima. Nullable: `NULL` até a primeira
  /// queda, ou depois de reconectar.
  disconnectReason WhatsAppDisconnectReason? @map("disconnect_reason")
  phoneNumber String?               @map("phone_number")
  connectedAt DateTime?             @map("connected_at")
  lastSeen    DateTime?             @map("last_seen")
  /// Milestone 5, Bloco M5A (D57) — ownership: qual usuario criou esta sessao.
  /// Coluna aditiva/nullable, SEM FK (referencia por id, decoupled — mesmo
  /// principio de `AiInteraction.conversationId`; o contexto de WhatsApp nao
  /// conhece a entidade `User`). Preenchimento e comportamento ficam no M5D;
  /// aqui so existe a coluna (mesma disciplina dos indices "prontos, YAGNI").
  createdByUserId String?           @map("created_by_user_id")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Uma sessão lógica (sessionName) é única por tenant. Isto formaliza,
  /// no nível de banco, a decisão arquitetural já aprovada: reconexão deve
  /// reaproveitar/atualizar o registro existente, nunca criar duplicata.
  /// `SessionManager.init(tenantId, sessionName)` já implementa esse reuso
  /// via `WhatsAppSessionRepository.findByTenantAndSessionName` (revisão
  /// arquitetural pós-Item 2 — ver PROJECT_STATUS.md).
  @@unique([tenantId, sessionName])
  @@index([tenantId])
  @@index([status])
  @@map("whatsapp_sessions")
}

/// Histórico append-only de transições de status de uma sessão do WhatsApp
/// (M2, Fase 2 — espelha `WhatsAppSessionEvent.ts`, Domain). Reaproveita o
/// mesmo padrão já usado no domínio legado entre `Conversation`/
/// `ConversationEvent`: `WhatsAppSession` é o estado ATUAL (sobrescrito a
/// cada transição); esta tabela é o LOG (uma linha por transição, nunca
/// sobrescrita/apagada).
///
/// Sem FK para WhatsAppSession (só para Tenant) — mesmo racional já usado
/// para `TenantCredential` acima: o histórico deve sobreviver à remoção da
/// sessão (`WhatsAppSessionService.removeSession()`, M2 Fase 1), então uma
/// FK para `WhatsAppSession.id` (com `onDelete: Cascade` ou `SetNull`)
/// serviria mal um log de auditoria — ou apagaria o histórico junto, ou
/// quebraria a rastreabilidade de qual sessão gerou cada evento.
model WhatsAppSessionEvent {
  id               String                     @id @default(uuid())
  tenantId         String                     @map("tenant_id")
  sessionName      String                     @map("session_name")
  status           WhatsAppSessionStatus
  disconnectReason WhatsAppDisconnectReason?  @map("disconnect_reason")
  occurredAt       DateTime                   @map("occurred_at")
  createdAt        DateTime                   @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Suporta diretamente `listRecentByTenantAndSessionName()` (filtro por
  /// tenant+sessão, ordenado por `occurredAt` desc, com `limit`).
  @@index([tenantId, sessionName, occurredAt])
  @@map("whatsapp_session_events")
}

/// Persistência genérica de segredos por tenant (port `CredentialsStore` em
/// `apps/api/src/shared/security/domain/CredentialsStore.ts`). Adicionado
/// para resolver a lacuna de persistência de credenciais/authState do
/// Baileys (antigo P2 do Architecture Review / M1A.6), mas deliberadamente
/// NÃO chamado `WhatsAppCredential`: o formato é chave-valor namespaced,
/// sem nenhum conceito de WhatsApp — reutilizável por qualquer futuro
/// consumidor que precise guardar segredos por tenant (outro provider de
/// WhatsApp, integrações de IA, OAuth de CRM), sem exigir uma tabela nova a
/// cada novo tipo de segredo.
///
/// Sem FK para WhatsAppSession (só para Tenant): o ciclo de vida de um
/// segredo é deliberadamente desacoplado do registro operacional de sessão
/// — se o registro de WhatsAppSession precisar ser recriado por qualquer
/// motivo, um `onDelete: Cascade` até ele não deve apagar credenciais (o
/// artefato mais caro de recriar: perdê-lo força o usuário a escanear QR
/// Code novamente). Reforça o racional já registrado no achado F5 (adiado)
/// sobre separar identidade de canal (durável) de sessão de conexão
/// (efêmera).
///
/// `value` já chega criptografado (AES-256-GCM, chave derivada por tenant —
/// ver `AesGcmCipher`) — este model nunca guarda texto plano.
model TenantCredential {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  namespace String
  key       String
  value     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, namespace, key])
  @@index([tenantId, namespace])
  @@map("tenant_credentials")
}

/// Conversa lógica entre um contato do WhatsApp e um tenant — Milestone 3,
/// Bloco 2 (espelha `services/conversations/domain/entities/Conversation.ts`).
///
/// Nome deliberadamente `WhatsAppConversation`, não `Conversation`: o schema
/// já tem um model `Conversation` no domínio legado "Milestone 003"
/// (congelado, ADR #11, ver seção de Enums/Models no topo deste arquivo) — o
/// Prisma Client gera um namespace ÚNICO por schema, e dois models com o
/// mesmo nome não compilam. Mesmo prefixo `WhatsApp` já usado por
/// `WhatsAppSession`/`WhatsAppSessionEvent` para toda a seção "WhatsApp
/// Connectivity". Risco já previsto e mitigado exatamente assim em
/// `MILESTONE_003_AI_AUTORESPONDER.md` §5 ("Colisão de nomenclatura com o
/// domínio legado: mapear com `@@map` explícito no Bloco 2").
model WhatsAppConversation {
  id          String                     @id @default(uuid())
  tenantId    String                     @map("tenant_id")
  sessionName String                     @map("session_name")
  /// JID do contato no WhatsApp (`InboundWhatsAppMessage.from`, Bloco 1).
  contactJid String                      @map("contact_jid")
  /// Milestone 6, Bloco M6H-2b — nome de exibição do WhatsApp (`pushName`,
  /// capturado pelo `BaileysProvider` a cada mensagem inbound). Nullable: só
  /// existe a partir da PRIMEIRA mensagem que carregar um `pushName` (nem
  /// toda mensagem do Baileys traz — ex.: histórico de sincronização já
  /// filtrado antes de chegar aqui). Reescrito a cada mensagem nova que
  /// trouxer um nome (o contato pode mudar o nome de exibição no WhatsApp) —
  /// nunca apagado por uma mensagem sem nome (ver `PrismaConversationRepository`).
  contactName String?                    @map("contact_name")
  status      WhatsAppConversationStatus @default(BOT)
  /// Milestone 5, Bloco M5A (D57) — ownership: qual usuario assumiu esta
  /// conversa (o "dono atual" do atendimento). Coluna aditiva/nullable, SEM
  /// FK (referencia por id, decoupled — o contexto de conversas nao conhece
  /// a entidade `User`). Preenchimento no M5D (escalate/resume/reassign);
  /// o historico atribuido vive no `AuditLog`.
  assignedToUserId String?             @map("assigned_to_user_id")
  /// Milestone 6 (reforma do escalonamento, 2026-07-25) — quando a IA pediu
  /// atenção humana pela ÚLTIMA vez (marcador de escalonamento OU falha ao
  /// gerar resposta), sem tirar a IA do circuito: `status` NÃO muda mais
  /// neste momento (só quando um humano de fato clica "Assumir conversa" —
  /// ver `ConversationsService.escalateConversation`, que também LIMPA este
  /// campo). `null` = ninguém pediu ajuda desde a última vez que um humano
  /// assumiu/a conversa foi criada. Reescrito (não só definido uma vez) a
  /// cada nova escalada — mesmo numa conversa que já estava sinalizada —
  /// para sustentar um novo alerta na Dashboard a cada pedido de ajuda,
  /// não só no primeiro.
  escalatedAt DateTime?                  @map("escalated_at")
  /// Indicador de não lidas (2026-07-25, pedido do fundador) — quantas
  /// mensagens INBOUND chegaram desde a última vez que um humano abriu esta
  /// conversa pela Dashboard. Denormalizado (contador, não um `COUNT(*)` a
  /// cada listagem): incrementado atomicamente em
  /// `MessageIngestionService.handle()` a cada mensagem inbound persistida, e
  /// zerado por `ConversationsService.markAsRead()` (`POST .../read`, novo
  /// endpoint) quando o operador abre a conversa. Nunca decrementado
  /// individualmente — sempre um reset completo para 0, mesmo racional de um
  /// "marcar tudo como lido". Mensagens OUTBOUND (da IA ou de um operador)
  /// nunca incrementam este campo — só o que o CONTATO manda é "não lido".
  unreadCount Int                        @default(0) @map("unread_count")
  /// Milestone 6, Bloco M6H-5 (2026-07-30) — estágio no funil de vendas. Toda
  /// conversa nasce em `NEW` (default, sem exigir preenchimento em nenhum
  /// ponto de criação existente — `upsertByTenantSessionAndContact` continua
  /// funcionando sem mudança). Gravado tanto por ação humana explícita
  /// (`ConversationsService.updateStage`, sempre permitida) quanto pela IA
  /// junto com cada resposta (`AiReplyJobProcessor`, só quando `stageSetBy`
  /// atual for `AI` — ver policy `shouldAiUpdateStage`).
  stage       ConversationStage          @default(NEW)
  /// Quem gravou `stage` pela última vez. Default `AI`: a IA pode classificar
  /// livremente até que um humano corrija manualmente pela primeira vez —
  /// a partir daí a IA nunca mais sobrescreve aquela conversa (decisão do
  /// fundador: evita o card "voltar sozinho" depois de uma correção).
  stageSetBy      ConversationStageSetBy @default(AI) @map("stage_set_by")
  /// Quando `stage` foi gravado pela última vez (por IA ou humano) —
  /// independente de `updatedAt` (que qualquer campo bumpa, ADR #79/#82) para
  /// permitir, no futuro, medir "tempo parado num estágio" sem ambiguidade
  /// com outra atividade da conversa (nova mensagem, marcar como lida etc.).
  stageUpdatedAt  DateTime               @default(now()) @map("stage_updated_at")
  /// ADR #94 (2026-08-01, validação Fase 1) — marca uma conversa como FORA
  /// do funil comercial (amigo/família/fornecedor/funcionário falando no
  /// mesmo número do WhatsApp usado pela empresa). Atributo ORTOGONAL a
  /// `stage`/`status`: não é mais um estágio do Kanban (um card "Não é
  /// cliente" ao lado de "Negociando" não é um estágio, é uma exclusão) —
  /// é um flag independente, mesmo padrão de `escalatedAt`/`unreadCount`
  /// nesta mesma entidade. Default `false`: toda conversa nasce dentro do
  /// funil comercial, igual sempre foi. Efeito em cascata é só FILTRO, não
  /// exclusão de dado: `shouldAutoRespond` para de liberar a IA, o board
  /// Kanban e o funil de Analytics passam a ignorar (`WHERE NOT
  /// excluded_from_pipeline`), mas mensagens/histórico continuam 100%
  /// acessíveis — só sai das telas comerciais, nunca do banco. Marcação
  /// deliberadamente MANUAL nesta rodada (nunca a IA) — errar aqui
  /// (marcar um cliente de verdade como "não comercial") é pior que não
  /// marcar nada.
  excludedFromPipeline Boolean @default(false) @map("excluded_from_pipeline")
  /// Fase 1, Bloco F1.7 (2026-08-01) — trecho da ÚLTIMA mensagem (qualquer
  /// direção, inbound ou outbound), para a linha da lista de Conversas
  /// (padrão Intercom/Slack/WhatsApp Web: "prévia" ao lado do horário).
  /// Denormalizado (mesmo padrão de `unreadCount`/`stageUpdatedAt` nesta
  /// mesma entidade) — gravado por `PrismaMessageRepository.create()` num
  /// único ponto de escrita (TODA mensagem, de qualquer origem — ingestão
  /// inbound, envio de texto/mídia do operador, resposta da IA — passa por
  /// esse método), nunca calculado por consulta a cada listagem. Para
  /// mensagens de mídia sem legenda, guarda um rótulo textual (ex.: "📷
  /// Imagem") em vez de string vazia — ver `buildMessagePreview()`.
  /// `null` só para conversas sem nenhuma mensagem ainda (nunca deveria
  /// acontecer na prática, toda conversa nasce de uma mensagem inbound, mas
  /// o tipo é opcional por segurança).
  lastMessagePreview String? @map("last_message_preview")
  /// Acompanha `lastMessagePreview` — quando a última mensagem ocorreu.
  /// Redundante com `updatedAt` na maioria dos casos, mas `updatedAt` também
  /// muda por escalonamento/estágio/leitura (ADR #79/#82/#94), então não
  /// serve como "quando a prévia foi gerada" de forma inequívoca.
  lastMessageAt DateTime? @map("last_message_at")
  /// Redesign 2026-08-05 (R5) — resumo da conversa gerado pela IA SOB
  /// DEMANDA (botão "Gerar resumo"/"Atualizar" no painel de contexto, nunca
  /// automático — custo previsível, controlado pelo operador). `null` até a
  /// primeira geração. Não é o `systemPrompt` do autoresponder — prompt
  /// dedicado, próprio deste recurso (ver `SummaryPromptBuilder`).
  aiSummary String? @map("ai_summary")
  /// Quando `aiSummary` foi gerado pela última vez — junto com
  /// `aiSummaryMessageCount`, permite a UI mostrar "desatualizado" quando
  /// mensagens novas chegaram depois da última geração, sem precisar
  /// comparar timestamps de mensagem a mensagem.
  aiSummaryUpdatedAt DateTime? @map("ai_summary_updated_at")
  /// Quantas mensagens a conversa tinha no momento em que `aiSummary` foi
  /// gerado — comparado com a contagem atual para acender o aviso de
  /// "desatualizado" (ver docstring de `aiSummaryUpdatedAt`). `0` até a
  /// primeira geração (nunca `null` — sempre comparável).
  aiSummaryMessageCount Int @default(0) @map("ai_summary_message_count")
  /// Fase L, Bloco L1 (2026-08-15) — liga esta conversa à identidade durável
  /// da pessoa (ver `WhatsAppContact`). Aditivo e NULLABLE de propósito, por
  /// dois motivos permanentes (não é um estado transitório de migração):
  /// conversas em `@lid` não têm telefone do qual derivar um contato, e o
  /// vínculo nunca pode ser pré-condição para receber uma mensagem — a
  /// ingestão continua funcionando igual se a resolução do contato falhar.
  /// `onDelete: SetNull` (não Cascade): apagar um contato jamais pode apagar o
  /// histórico de conversa, que é o dado mais caro do produto.
  contactId   String?                    @map("contact_id")
  createdAt   DateTime                   @default(now()) @map("created_at")
  updatedAt   DateTime                   @updatedAt @map("updated_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact  WhatsAppContact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  messages WhatsAppMessage[]
  /// Redesign 2026-08-05 (R4) — tags livres atribuídas a esta conversa
  /// (N:N via `WhatsAppConversationTag`). Ver `WhatsAppTag` para o catálogo.
  conversationTags WhatsAppConversationTag[]

  /// Chave lógica única de uma conversa: um contato só tem UMA conversa por
  /// sessão de um tenant. Formaliza no banco a mesma garantia que
  /// `PrismaConversationRepository.upsertByTenantSessionAndContact()`
  /// depende para ser atômico (mesmo racional de
  /// `WhatsAppSession.@@unique([tenantId, sessionName])`, ADR #25/P6).
  @@unique([tenantId, sessionName, contactJid])
  @@index([tenantId])
  /// Suporta o board Kanban (M6H-5/M6I): buscar todas as conversas de UMA
  /// sessão, agrupadas por estágio — mesmo racional de índice composto já
  /// usado em `WhatsAppSessionEvent(tenantId, sessionName, occurredAt)`.
  @@index([tenantId, sessionName, stage])
  /// Fase 1, Bloco F1.10 (estabilidade para beta) — cobre o padrão real da
  /// query mais executada do produto: `findAllByTenant` filtra por
  /// `tenantId`+`sessionName` (a Dashboard sempre lista Conversas dentro de
  /// UMA sessão) e ordena por `lastMessageAt` (ver comentário em
  /// `PrismaConversationRepository.findAllByTenant`) — chamada a cada poll de
  /// SSE (~2s) de toda aba de operador aberta. Sem este índice a ordenação
  /// cai em sort em memória a partir de um certo volume de conversas por
  /// sessão. Ordem ascendente padrão (sem `sort: Desc`, feature de índice não
  /// habilitada neste schema): o Postgres varre um B-tree ascendente "de trás
  /// para frente" com o mesmo custo para servir `ORDER BY ... DESC`, então a
  /// direção declarada aqui não importa para este propósito.
  @@index([tenantId, sessionName, lastMessageAt])
  /// Fase L, Bloco L1 — suporta "todas as conversas desta pessoa", que é o
  /// ganho central da identidade: cruzar as sessões de um mesmo tenant.
  @@index([contactId])
  @@map("whatsapp_conversations")
}

/// Uma mensagem (inbound ou outbound) de uma `WhatsAppConversation` —
/// Milestone 3, Bloco 2 (espelha
/// `services/conversations/domain/entities/Message.ts`). Append-only: nunca
/// atualizada após criada (sem `updatedAt`, mesmo padrão de
/// `WhatsAppSessionEvent`).
///
/// Nome deliberadamente `WhatsAppMessage`, não `Message` — mesmo racional de
/// colisão com o domínio legado já documentado em `WhatsAppConversation`
/// acima.
///
/// COM FK para `WhatsAppConversation` (`onDelete: Cascade`), diferente do
/// padrão "sem FK" usado por `WhatsAppSessionEvent`/`TenantCredential`: essas
/// duas são logs de AUDITORIA que devem sobreviver à entidade que
/// referenciam; `WhatsAppMessage` não é um log de auditoria independente —
/// é conteúdo que pertence genuinamente à conversa (mesmo racional do model
/// legado `Message.conversation @relation(...)`, sem cascade explícito lá,
/// mas com o mesmo sentido de posse).
model WhatsAppMessage {
  id             String                   @id @default(uuid())
  tenantId       String                   @map("tenant_id")
  conversationId String                   @map("conversation_id")
  direction      WhatsAppMessageDirection
  /// Para mídia (`contentType != TEXT`): a legenda (`caption`) quando houver,
  /// ou string vazia — nunca `null`, para não forçar todo consumidor
  /// existente (`PromptBuilder`, `MessageTimeline`) a tratar ausência.
  content        String
  /// Fase 1, Bloco F1.1 (ADR #90). Default `TEXT` preserva compatibilidade
  /// total com toda linha existente antes desta migration (nenhum backfill
  /// necessário — toda mensagem já persistida É texto, por definição: mídia
  /// era descartada antes de chegar aqui).
  contentType    WhatsAppMessageContentType @default(TEXT) @map("content_type")
  /// Mimetype do arquivo de mídia (ex.: `image/jpeg`, `audio/ogg; codecs=opus`).
  /// `NULL` quando `contentType == TEXT`.
  mediaMimeType  String?                  @map("media_mime_type")
  /// URL `.enc` bruta do CDN do WhatsApp (ADR #90) — expira e é inútil sem
  /// `mediaKeyEncrypted`; nunca servida diretamente ao cliente do Dashboard,
  /// só consumida internamente por `WhatsAppProvider.downloadMedia()`.
  mediaUrl       String?                  @map("media_url") @db.Text
  /// `mediaKey` do protocolo Signal/WhatsApp, cifrada pelo mesmo `Cipher`
  /// (AES-256-GCM, chave derivada por tenant) já usado em
  /// `TenantCredential.value` — NUNCA em texto plano (ADR #90).
  mediaKeyEncrypted String?               @map("media_key_encrypted") @db.Text
  /// Nome de arquivo original, quando o WhatsApp o informa (comum em
  /// mensagens de documento). `NULL` para os demais tipos/quando ausente.
  mediaFileName  String?                  @map("media_file_name")
  /// Instante de negócio (recebida/enviada) — distinto de `createdAt`
  /// (quando a linha foi persistida). Mesmo padrão de
  /// `WhatsAppSessionEvent.occurredAt`.
  occurredAt DateTime                     @map("occurred_at")
  createdAt      DateTime                 @default(now()) @map("created_at")

  conversation WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// Suporta uma futura listagem cronológica de mensagens de uma conversa
  /// (`PromptBuilder`, Bloco 3a — não implementada ainda, YAGNI, mas o índice
  /// já é a decisão de schema correta desde já).
  @@index([conversationId, occurredAt])
  @@index([tenantId])
  /// Milestone 4 (Analytics), Bloco M4A — D43/ADR #59. Série temporal
  /// tenant-wide (fluxo inbound/outbound por dia): as consultas de analytics
  /// filtram por `tenantId` + range de `occurredAt`, sem `conversationId`. O
  /// índice `[conversationId, occurredAt]` acima não serve esse padrão
  /// (prefixo errado); `[tenantId]` sozinho não cobre o range temporal.
  /// Índice estritamente aditivo — nenhuma coluna/constraint/contrato
  /// alterado. Analytics é read-only (D51): este índice só acelera leitura.
  @@index([tenantId, occurredAt])
  @@map("whatsapp_messages")
}

// ---------- Enums (IA — Milestone 3, Bloco 3b) ----------

/// Provider de IA que gerou uma `AiInteraction`. Enum, não `string` livre —
/// mesmo racional do achado F6/ADR #15. Nome deliberadamente `AiProviderType`,
/// não `AiProvider` (colidiria com o nome do port de Domain
/// `services/ai/domain/providers/AiProvider.ts`) nem `WhatsAppProviderType`
/// (que já existe e significa outra coisa — provider de CONEXÃO, `BAILEYS`;
/// este enum é o provider de GERAÇÃO DE TEXTO). Valores espelham
/// `AiProviderName` (Domain, `services/ai/domain/providers/AiProviderName.ts`);
/// mapeamento `'claude'` ↔ `CLAUDE` via `Record`, mesmo padrão de
/// `DIRECTION_TO_PRISMA` em `PrismaMessageRepository.ts`.
enum AiProviderType {
  CLAUDE
  OPENAI
  GEMINI

  @@map("ai_provider_type")
}

/// Resultado de uma tentativa de geração de resposta de IA — espelha
/// `ConversationAiResult['status']` (Application,
/// `services/ai/application/ConversationAiService.ts`). Sem `TIMEOUT`: mesmo
/// racional já documentado em `ConversationAiResult` (Bloco 3a) — nenhum
/// código deste projeto ainda distingue timeout de outros erros de provider.
enum AiInteractionStatus {
  SUCCESS
  VALIDATION_REJECTED
  PROVIDER_ERROR

  @@map("ai_interaction_status")
}

/// Fase 1, Bloco F1.4 (2026-08-01) — motivo da escalada para atendimento
/// humano, quando `AiInteraction.status = SUCCESS` E a IA emitiu um marcador
/// de escalonamento (espelha `EscalationReason`,
/// `services/ai/domain/escalationSignal.ts`). `null` = a IA não escalou
/// nesta tentativa (resposta normal, ou falha antes de gerar qualquer
/// conteúdo).
enum AiEscalationReason {
  /// A IA não sabia responder com segurança — sinal de LACUNA real de
  /// conteúdo (pré-requisito para a captura automática de lacunas, ADR #71
  /// itens b/c).
  UNKNOWN_ANSWER
  /// O cliente pediu explicitamente para falar com uma pessoa — preferência
  /// do cliente, não uma lacuna de conteúdo.
  REQUESTED_HUMAN

  @@map("ai_escalation_reason")
}

// ---------- Models (IA — Milestone 3, Bloco 3b) ----------

/// Registro de auditoria/billing de UMA tentativa de geração de resposta de
/// IA — Milestone 3, Bloco 3b (espelha
/// `services/ai/domain/entities/AiInteraction.ts`). Append-only, gravado em
/// TODA tentativa (sucesso, validação rejeitada, erro do provider) — nunca
/// só nos sucessos (critério de aceite,
/// `MILESTONE_003_AI_AUTORESPONDER.md` §6).
///
/// SEM FK para `WhatsAppConversation`/`WhatsAppMessage` (só para `Tenant`) —
/// mesmo racional já usado 2x neste projeto para logs de auditoria:
/// `TenantCredential` sem FK para `WhatsAppSession` (ADR #21);
/// `WhatsAppSessionEvent` chaveado por `tenantId`+`sessionName`, não
/// `sessionId` (ADR #49). Um registro de billing deve sobreviver à exclusão
/// da conversa que audita (ex.: retenção de dados/LGPD) — se
/// `WhatsAppConversation`/`WhatsAppMessage` forem um dia apagadas, o custo já
/// registrado não deveria desaparecer junto.
///
/// `model`/`messageId` são nullable — `model` porque, no caminho
/// `PROVIDER_ERROR`, a chamada ao provider falhou antes de qualquer resposta
/// chegar (o `model` real só é conhecido pela resposta da API); `messageId`
/// porque o Bloco 3b não cria a `Message` outbound com a resposta da IA
/// (isso só acontece quando o envio de fato ocorre, Bloco 4).
///
/// `costUsd` é `Decimal`, nunca `Float` — arredondamento de ponto flutuante
/// não é aceitável para dinheiro (`MILESTONE_003_AI_AUTORESPONDER.md` §2.7,
/// Decisão A). `Decimal(12, 8)`: 8 casas decimais — custo por token costuma
/// ser frações de centavo.
model AiInteraction {
  id             String               @id @default(uuid())
  tenantId       String               @map("tenant_id")
  conversationId String               @map("conversation_id")
  messageId      String?              @map("message_id")
  provider       AiProviderType
  model          String?
  promptVersion  String               @map("prompt_version")
  tokensInput    Int                  @map("tokens_input")
  tokensOutput   Int                  @map("tokens_output")
  costUsd        Decimal              @map("cost_usd") @db.Decimal(12, 8)
  latencyMs      Int                  @map("latency_ms")
  status         AiInteractionStatus
  errorMessage   String?              @map("error_message") @db.Text
  /// Fase 1, Bloco F1.4 (2026-08-01) — ver docstring de `AiEscalationReason`.
  /// Nullable/aditivo: `null` para toda interação gravada antes deste bloco
  /// e para qualquer tentativa em que a IA não escalou.
  escalationReason AiEscalationReason? @map("escalation_reason")
  createdAt      DateTime             @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Suporta consultas futuras de billing/auditoria por tenant+conversa,
  /// ordenadas por data (Bloco 5, `listByTenant()`/`sumCostByTenant()` —
  /// não implementadas ainda, YAGNI, mas o índice já é a decisão de schema
  /// correta desde já, mesmo padrão de `WhatsAppMessage.conversationId`).
  @@index([tenantId, conversationId, createdAt])
  /// Milestone 4 (Analytics), Bloco M4A — D43/ADR #59. Série temporal
  /// tenant-wide de uso de IA (custo/tokens/latência/status por dia): as
  /// consultas de analytics filtram por `tenantId` + range de `createdAt`,
  /// SEM `conversationId`. O índice `[tenantId, conversationId, createdAt]`
  /// acima tem `conversationId` no meio, então não serve uma agregação por
  /// tenant que ignora a conversa (o range de `createdAt` não é usável sem
  /// fixar `conversationId`). Índice estritamente aditivo — nenhuma
  /// coluna/constraint/contrato alterado. Analytics é read-only (D51): este
  /// índice só acelera leitura.
  @@index([tenantId, createdAt])
  @@map("ai_interactions")
}

/// Base de Conhecimento (Nivel 1) — "Cerebro da IA" por empresa. UM texto
/// livre por tenant onde o dono do negocio descreve quem e a empresa, o que
/// vende, precos, horarios e regras de atendimento. Esse texto e ANEXADO ao
/// prompt de sistema base (nao o substitui — as regras de seguranca anti-
/// alucinacao/escalonamento continuam sempre ativas; ver PromptBuilder).
///
/// `tenantId @unique`: relacao 1:1 com Tenant — ha no maximo um perfil por
/// empresa. Deliberadamente uma tabela DEDICADA (nao uma coluna em Tenant):
/// o bounded context `ai` e dono desta config, mantendo `Tenant` enxuto e a
/// fronteira limpa (mesmo espirito de `AiInteraction`). NAO reusa o nome
/// "KnowledgeBase" da §10 do CLAUDE.md — aquele fica reservado para o Nivel 2
/// (RAG com embeddings, multiplas entradas); este e o blob unico do Nivel 1.
///
/// `content` @db.Text: sem limite pratico de tamanho (catalogos podem ser
/// longos). Aditiva e isolada: nenhuma tabela existente e alterada.
/// Milestone 6, Bloco M6H-3 (2026-07-25) — migrado de 1:1 por TENANT para 1:1
/// por SESSÃO de WhatsApp (`sessionName`): cada número atendido pelo Francis
/// pode ter seu próprio "cérebro" (empresa/produto/preços diferentes por
/// linha, ex.: uma franquia com um WhatsApp por unidade). `sessionName`
/// aditivo/nullable na migration (para o backfill rodar antes do
/// `NOT NULL`); a chave única passou de `tenantId` sozinho para
/// `(tenantId, sessionName)` — ver `20260725160000_ai_business_profile_per_session`.
model AiBusinessProfile {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  sessionName String   @map("session_name")
  content     String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  /// F1.8 — Horário de atendimento configurável por sessão (2026-08-01).
  /// Quando `offHoursEnabled` é true e o horário atual (no `timezone`) estiver
  /// fora do intervalo [`workingHoursStart`, `workingHoursEnd`) nos dias
  /// `workingDays` (bitmask: bit0=Dom, bit1=Seg…bit6=Sáb; 62=Seg-Sex),
  /// o `PromptBuilder` injeta um aviso no system prompt para a IA informar o
  /// cliente sobre o horário — sem silenciar a resposta (a IA continua
  /// respondendo dentro do seu conhecimento, só sinaliza o horário).
  offHoursEnabled   Boolean @default(false) @map("off_hours_enabled")
  offHoursMessage   String? @db.Text @map("off_hours_message")
  workingHoursStart String? @map("working_hours_start")
  workingHoursEnd   String? @map("working_hours_end")
  workingDays       Int     @default(62) @map("working_days")
  timezone          String  @default("America/Sao_Paulo") @map("timezone")

  /// Fase 1 (2026-08-07) — Botão POWER da IA: liga/desliga a resposta
  /// AUTOMÁTICA da IA para NOVAS mensagens desta sessão, sem afetar a conexão
  /// do WhatsApp, o recebimento de mensagens, o Pipeline/Analytics ou o envio
  /// manual pelo atendente (ver `shouldAutoRespond`, Domain de
  /// `services/conversations`). `true` por padrão — inclusive para sessões
  /// que NUNCA configuraram o Cérebro da IA (nenhuma linha nesta tabela
  /// ainda): a leitura em `AiAvailabilityRepository`/`ConversationAiService`
  /// trata "sem perfil" como `aiEnabled = true`, nunca `false`.
  aiEnabled Boolean @default(true) @map("ai_enabled")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sessionName])
  @@map("ai_business_profiles")
}

/// Fase 1, Bloco F1.9 — respostas rapidas (templates) para o atendente
/// humano inserir com um clique no MessageComposer. POR SESSAO (nao por
/// tenant, mesmo padrao de AiBusinessProfile/M6H-3): cada WhatsApp pode ter
/// seu proprio conjunto de respostas prontas. Sem `@@unique` — varias linhas
/// por (tenantId, sessionName), ordenadas por createdAt na leitura.
model QuickReply {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  sessionName String   @map("session_name")
  content     String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, sessionName])
  @@map("quick_replies")
}

/// Redesign 2026-08-05 (R4) — paleta FIXA de cores de tag (8 opções — decisão
/// do fundador via `AskUserQuestion`: "bolinhas" de cor pré-definidas, não
/// hex livre, para garantir legibilidade em ambos os temas sem cálculo de
/// contraste em tempo real). Enum (não `String` livre) — mesmo racional já
/// usado para `ConversationStage`/`WhatsAppMessageContentType`: conjunto
/// fechado, o Prisma/Postgres recusam um valor fora da lista na origem.
enum TagColor {
  GRAY
  RED
  ORANGE
  AMBER
  GREEN
  TEAL
  BLUE
  PURPLE

  @@map("tag_color")
}

/// Redesign 2026-08-05 (R4) — catálogo de tags livres, POR SESSÃO (mesmo
/// padrão do Cérebro da IA/Respostas Rápidas, ADR #82): cada WhatsApp tem
/// seu próprio conjunto de etiquetas. Deliberadamente `WhatsAppTag`, NÃO o
/// `model Tag` do domínio legado congelado (ADR #11) — mesmo racional de
/// prefixo já usado por `WhatsAppConversation`/`WhatsAppMessage` para evitar
/// colisão de nome no Prisma Client (namespace único por schema).
model WhatsAppTag {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  sessionName String   @map("session_name")
  name        String
  color       TagColor @default(GRAY)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant           Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversationTags WhatsAppConversationTag[]

  /// Nome único por sessão (não faz sentido duas tags "VIP" na mesma sessão).
  @@unique([tenantId, sessionName, name])
  @@index([tenantId, sessionName])
  @@map("whatsapp_tags")
}

/// Redesign 2026-08-05 (R4) — junção N:N entre conversa e tag. Sem `id`
/// próprio: a chave primária composta já garante "no máximo uma atribuição
/// da mesma tag à mesma conversa" (idempotente por construção — atribuir de
/// novo não duplica linha). `onDelete: Cascade` nos dois lados: apagar a
/// conversa OU a tag limpa as atribuições, sem linha órfã.
model WhatsAppConversationTag {
  conversationId String   @map("conversation_id")
  tagId          String   @map("tag_id")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag          WhatsAppTag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([conversationId, tagId])
  @@index([tagId])
  @@map("whatsapp_conversation_tags")
}

// ---------- Enums (Auth / Multiusuario — Milestone 5, Bloco M5A) ----------

/// Papel (cargo) de um usuario dentro de um tenant. RBAC FIXO em codigo
/// (D55): os papeis sao um conjunto fechado, versionado junto com o codigo,
/// nao linhas editaveis. Papel UNICO por usuario (D56). Mapeado para as
/// unioes literais do Domain via Record (mesmo padrao de
/// `DIRECTION_TO_PRISMA`/`PROVIDER_TO_PRISMA`).
enum UserRole {
  OWNER
  ADMINISTRATOR
  MANAGER
  OPERATOR
  READ_ONLY

  @@map("user_role")
}

/// Estado de uma conta de usuario. `SUSPENDED` bloqueia login sem apagar a
/// ficha (preserva historico/auditoria) — mesmo espirito de soft-delete.
enum UserStatus {
  ACTIVE
  SUSPENDED

  @@map("user_status")
}

// ---------- Models (Auth / Multiusuario — Milestone 5, Bloco M5A) ----------

/// Usuario (pessoa) que acessa o Dashboard, dentro de um tenant — Milestone
/// 5, Bloco M5A (espelha `services/auth/domain/entities/User.ts`).
///
/// `email` unico POR TENANT (nao global): a mesma pessoa poderia, no futuro,
/// existir em duas empresas distintas (D64 mantem 1 tenant por usuario no
/// MVP, mas a unicidade composta ja deixa a porta certa). `passwordHash`
/// nunca a senha em texto plano (mesmo principio de `Tenant.apiKeyHash`) —
/// o algoritmo de hash de senha (Argon2/bcrypt) e escopo do M5B.
model User {
  id           String     @id @default(uuid())
  tenantId     String     @map("tenant_id")
  email        String
  passwordHash String     @map("password_hash")
  role         UserRole
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at")

  /// Marca uma senha PROVISORIA (definida por um admin no convite/reset).
  /// Enquanto `true`, o usuario e obrigado a trocar a senha antes de usar o
  /// sistema — Milestone 5, Bloco M5E (D64). Default `false` para nao afetar
  /// nenhuma conta ja existente (o OWNER criado via script, por exemplo).
  mustChangePassword Boolean @default(false) @map("must_change_password")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

/// Token de renovacao de sessao (o "cartao de ponto" de longa duracao) —
/// Milestone 5, Bloco M5A. Guardamos so o HASH do token, nunca o valor cru
/// (mesmo principio de `apiKeyHash`/`passwordHash`): quem vaza o banco nao
/// consegue reusar os tokens. `revokedAt` permite REVOGAR (logout, troca de
/// senha, deteccao de roubo) sem apagar a linha — a rotacao e a deteccao de
/// reuso sao escopo do M5B. COM FK para `User` (Cascade): o token nao e um
/// log de auditoria independente, pertence ao usuario e some com ele.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  userAgent String?   @map("user_agent")
  ip        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Trilha de auditoria append-only (o "livro da portaria") — Milestone 5,
/// Bloco M5A. Uma linha por evento relevante (login, mudanca de permissao,
/// acao critica), atribuida a um ator. Nunca atualizada/apagada (mesmo
/// padrao imutavel de `AiInteraction`/`WhatsAppSessionEvent`).
///
/// `actorUserId` e uma String nullable SEM FK (nao um relation Prisma) — de
/// proposito, exatamente como `AiInteraction` faz com `conversationId`: um
/// registro de auditoria deve SOBREVIVER a exclusao do usuario que agiu, E
/// preservar o id de quem foi (uma FK `SetNull` apagaria o autor; sem FK, o
/// id fica gravado para sempre). `metadata` (Json) guarda detalhes livres do
/// evento sem exigir uma coluna por tipo.
model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  actorUserId String?  @map("actor_user_id")
  action      String
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  metadata    Json?
  ip          String?
  userAgent   String?  @map("user_agent")
  occurredAt  DateTime @default(now()) @map("occurred_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, occurredAt])
  @@index([tenantId, actorUserId, occurredAt])
  @@index([tenantId, action, occurredAt])
  @@map("audit_logs")
}
