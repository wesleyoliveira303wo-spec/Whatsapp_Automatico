{
  "name": "whatsapp-automatico",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services",
    "infrastructure"
  ],
  "scripts": {
    "lint-staged": "lint-staged",
    "dev": "concurrently -n api,worker,dashboard -c blue,magenta,green \"cross-env PORT=4000 npm run dev -w apps/api\" \"npm run dev:worker -w apps/api\" \"npm run dev -w apps/dashboard\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint . --ext .js,.ts,.tsx",
    "test": "jest",
    "format": "prettier --write \"**/*.{js,ts,tsx,json,md}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.0.0",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.5",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5"
  }
}
