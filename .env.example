# PostgreSQL
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=whatsapp
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# API
# Nota: valores literais (não ${VAR} aninhado) porque o pacote "dotenv"
# usado em apps/api não expande variáveis dentro do próprio .env — só o
# bloco "environment:" do docker-compose.yml faz esse tipo de interpolação.
PORT=4000
DATABASE_URL=postgresql://user:password@postgres:5432/whatsapp?schema=public
# Chave mestra para criptografar credenciais do WhatsApp (AesGcmCipher) —
# gere com: openssl rand -base64 32
WHATSAPP_CREDENTIALS_MASTER_KEY=
# Pepper para hash de API keys (HmacSha256ApiKeyHasher, Production Hardening) —
# gere com: openssl rand -base64 32
API_KEY_PEPPER=

# Worker de IA (Milestone 3, Bloco 4 — apps/api/src/worker.ts)
# Qual provider de IA o worker usa para gerar respostas. Suportados hoje:
#   claude  -> ClaudeAiProvider (SDK da Anthropic; melhor desempenho, pago)
#   gemini  -> GeminiAiProvider (API REST do Google; tem FREE TIER no AI Studio)
# Opcional — default "claude" quando omitido (compatibilidade com deploys
# anteriores à M6). Só as credenciais do provider ESCOLHIDO são exigidas na
# subida do worker; as do outro provider podem ficar em branco.
AI_PROVIDER=claude

# --- Opção A: Claude (Anthropic) ---
# Chave de API da Anthropic (Claude) — usada por ClaudeAiProvider.
# NUNCA versionar um valor real aqui; a chave de verdade fica só no .env
# local (git-ignorado) ou no secret manager de produção.
CLAUDE_API_KEY=
# Identificador do modelo Claude a usar — string livre porque nomes de
# modelo mudam com frequência (ver docstring de ClaudeAiProvider). Exemplo
# válido em 2026-07: claude-sonnet-4-5-20250929 (confirme o identificador
# atual na documentação da Anthropic antes de subir para produção).
AI_CLAUDE_MODEL=
# Opcional — default 1024 tokens quando omitido (ver DEFAULT_MAX_TOKENS em
# ClaudeAiProvider.ts).
AI_CLAUDE_MAX_TOKENS=

# --- Opção B: Gemini (Google) — obtenha a chave GRÁTIS em aistudio.google.com ---
# Chave de API do Google AI Studio — usada por GeminiAiProvider. Gerada sem
# cartão de crédito; o free tier cobre desenvolvimento e baixo volume. Mesma
# regra do CLAUDE_API_KEY: nunca versionar um valor real.
GEMINI_API_KEY=
# Identificador do modelo Gemini — string livre (nomes mudam; modelos antigos
# saem do ar para contas novas). Recomendado o alias "-latest", que o Google
# mantém apontando para o Flash estável atual (não quebra quando trocam de
# versão). Alternativas: gemini-flash-lite-latest (limites de free tier mais
# altos), ou um id fixo como gemini-3.5-flash. Confirme o id atual em
# ai.google.dev/gemini-api/docs/models antes de produção.
AI_GEMINI_MODEL=gemini-flash-latest
# Opcional — default 1024 tokens quando omitido (ver DEFAULT_MAX_TOKENS em
# GeminiAiProvider.ts).
AI_GEMINI_MAX_TOKENS=
# Opcional — default "v1" quando omitido (ver PROMPT_VERSIONS em
# services/ai/domain/PromptVersion.ts). Trocar de prompt em produção exige
# alterar este valor E fazer deploy (decisão A do §2.6 do
# MILESTONE_003_AI_AUTORESPONDER.md — registro em código, não em banco).
AI_PROMPT_VERSION=v1
# Opcional — default 20 mensagens quando omitido (ver DEFAULT_HISTORY_LIMIT
# em AiReplyJobProcessor.ts). Quantas mensagens recentes da conversa entram
# no histórico enviado ao provider de IA a cada resposta gerada.
AI_HISTORY_LIMIT=20

# Dashboard (M2, Fase 3 — BFF)
# Base URL do apps/api, lida SOMENTE no servidor do Next.js (rotas
# pages/api/*) — nunca NEXT_PUBLIC_*, porque o browser não deve mais falar
# direto com a API (ver decisão de arquitetura da Milestone 2: o Dashboard
# passou a atuar como Backend-for-Frontend). Em Docker, aponta para o
# hostname do serviço na rede interna do compose (não localhost); rodando
# fora do Docker (`npm run dev` direto), aponta para onde a API estiver.
API_BASE_URL=http://localhost:4000
# Chave para cifrar o cookie httpOnly de sessão do Dashboard (API key do
# tenant, nunca exposta ao browser) — gere com: openssl rand -base64 32
# Deliberadamente SEPARADA de WHATSAPP_CREDENTIALS_MASTER_KEY (domínios de
# segurança diferentes, ver lib/cookieCipher.ts).
DASHBOARD_SESSION_SECRET=

# ============================================================
# Milestone 5 — Autenticacao / Multiusuario (Bloco M5C)
# ============================================================
# Segredo para ASSINAR o cracha de acesso (JWT HS256). Obrigatorio para as
# rotas de auth (login/refresh/logout/me) subirem — sem ele, elas nao sao
# montadas (o resto da API continua funcionando). Gere com:
#   openssl rand -base64 48
# Deliberadamente SEPARADO de DASHBOARD_SESSION_SECRET/API_KEY_PEPPER
# (dominios de seguranca diferentes).
ACCESS_TOKEN_SECRET=
# Opcional — validade do cracha de acesso em segundos (default 900 = 15 min).
# Curto de proposito: o cartao de ponto (refresh) renova sem pedir senha.
ACCESS_TOKEN_TTL_SECONDS=900
# Opcional — validade do cartao de ponto (refresh token) em dias (default 7).
REFRESH_TOKEN_TTL_DAYS=7
