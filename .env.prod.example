# .env de PRODUÇÃO (deploy T9 — VM Oracle Cloud Always Free + Caddy).
#
# COPIE para `.env` NA VM (nunca versione o arquivo preenchido):
#   cp .env.prod.example .env   # e preencha os campos "<...>"
#
# O assistente `scripts/deploy-t9-wizard.sh` gera este arquivo já preenchido
# (secrets aleatórios inclusos). Este exemplo existe para consulta e para
# preencher à mão se preferir.
#
# Convenção: valores literais (sem ${VAR} aninhado) — o dotenv do apps/api
# não expande variáveis dentro do próprio .env.

# ── Caddy / host público (usados só pelo docker-compose.caddy.yml) ──────────
# Host = IP público da VM com os pontos trocados por traços + ".sslip.io".
# Ex.: IP 129.159.1.2  ->  SITE_HOST=129-159-1-2.sslip.io
SITE_HOST=<ip-com-tracos>.sslip.io
ACME_EMAIL=<seu-email@exemplo.com>

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_USER=francis
POSTGRES_PASSWORD=<gere: openssl rand -base64 32>
POSTGRES_DB=francis
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# DATABASE_URL: o docker-compose.prod.yml sobrescreve com o hostname interno
# `postgres`; manter aqui coerente para os scripts rodados de dentro do
# container `api` (ex.: setTenantPlan, deleteTenant).
DATABASE_URL=postgresql://francis:<mesma-senha-acima>@postgres:5432/francis?schema=public

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ── API ───────────────────────────────────────────────────────────────────
PORT=4000
# Cifra as credenciais do WhatsApp (AES-256-GCM). PERDER esta chave = escanear
# QR de novo em todas as sessões. Guarde uma cópia fora da VM.
WHATSAPP_CREDENTIALS_MASTER_KEY=<gere: openssl rand -base64 32>
# Pepper do hash de API key.
API_KEY_PEPPER=<gere: openssl rand -base64 32>
# Restaura as sessões CONNECTED automaticamente após um restart da API.
WHATSAPP_AUTO_RESTORE=true

# ── Provedor de IA ────────────────────────────────────────────────────────
AI_PROVIDER=gemini
# Chave do Google AI Studio (grátis, sem cartão): https://aistudio.google.com/apikey
GEMINI_API_KEY=<sua-chave-do-ai-studio>
# Modelo estável com cota generosa (ver .env.example para o porquê de não usar "-latest").
AI_GEMINI_MODEL=gemini-3.5-flash
# 2048 evita resposta cortada (os Flash 3.x "pensam" e consomem o mesmo orçamento).
AI_GEMINI_MAX_TOKENS=2048
# Versão do prompt. T9 pede "v4"; o .env.example recomenda "v10" (mais
# refinada — v3..v10 iteram a postura de venda sobre a base de v2). Use v10
# salvo instrução em contrário do fundador. SEM default seguro: se faltar,
# o worker cai em "v1" (só anti-alucinação).
AI_PROMPT_VERSION=v10
AI_HISTORY_LIMIT=20
# Pipeline anda sozinho mesmo com a IA desligada ou com humano atendendo
# (2026-09-11). Ver .env.example para o detalhe. Opcionais.
AI_STAGE_CLASSIFIER_ENABLED=true
# AI_STAGE_CLASSIFIER_DELAY_MS=180000
# AI_STAGE_CLASSIFIER_MODEL=

# ── Interpretação de mídia pela IA (F1.2) ─────────────────────────────────
# Segredo compartilhado entre `api` e `worker` para a rota interna de mídia.
INTERNAL_API_SECRET=<gere: openssl rand -base64 32>
# O compose já injeta INTERNAL_API_BASE_URL=http://api:4000 no worker.
INTERNAL_API_BASE_URL=http://api:4000

# ── Dashboard (BFF) ──────────────────────────────────────────────────────
# O compose sobrescreve com http://api:4000 (rede interna). Manter coerente.
API_BASE_URL=http://api:4000
# Cifra o cookie httpOnly de sessão do Dashboard.
DASHBOARD_SESSION_SECRET=<gere: openssl rand -base64 32>

# ── Autenticação / multiusuário (M5) ─────────────────────────────────────
# Assina o JWT de acesso (HS256). Sem ele, as rotas de auth não sobem.
ACCESS_TOKEN_SECRET=<gere: openssl rand -base64 48>
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Atrás do Caddy há 1 hop de proxy — mantenha 1.
TRUST_PROXY_HOPS=1

# ── Painel /admin — Platform Control Center (Fases 1–6) ────────────────────
# TRÊS segredos, cada um com um papel só. A API RECUSA SUBIR se dois deles
# (ou qualquer um vs. ACCESS_TOKEN_SECRET) forem iguais.
# Ausentes: o resto do produto sobe normal, só o /admin não monta.
#
# Assina o crachá da sessão do dono da plataforma na API (HS256).
PLATFORM_SESSION_SECRET=<gere: openssl rand -base64 48>
# Opcional — validade da sessão do /admin em segundos (default 28800 = 8h).
PLATFORM_SESSION_TTL_SECONDS=28800
# Cifra o cookie `wa_admin_session` no Dashboard (BFF) — separado do de cima
# (aquele ASSINA na API, este CIFRA no navegador). Sem ele, /admin/login dá
# erro de configuração.
PLATFORM_DASHBOARD_SESSION_SECRET=<gere: openssl rand -base64 32>
# Crachá do ACESSO ASSISTIDO (Fase 5 — o dono operando o tenant de um cliente
# por 2h, com o aceite dele). Ausente: pedir/autorizar/revogar funciona, mas
# "Entrar na conta" não.
SUPPORT_ACCESS_TOKEN_SECRET=<gere: openssl rand -base64 48>
